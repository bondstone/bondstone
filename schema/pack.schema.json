{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bondstone/bondstone/proof-of-concept/schema/pack.schema.json",
  "title": "bondstone pack file (pack.yaml)",
  "type": "object",
  "required": ["pack", "version", "bondstone", "description"],
  "additionalProperties": false,
  "properties": {
    "pack": {"$ref": "#/$defs/name"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"},
    "bondstone": {"type": "string", "description": "Engine version range."},
    "description": {"type": "string", "minLength": 1},
    "requires": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"type": "string", "description": "Semver range."}
    },
    "types": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/type"}
    },
    "links": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/linkName"},
      "additionalProperties": {"$ref": "#/$defs/link"}
    },
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
    "views": {"type": "array", "items": {"$ref": "#/$defs/view"}},
    "profiles": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {
        "type": "object",
        "propertyNames": {"$ref": "#/$defs/name"},
        "additionalProperties": {"$ref": "#/$defs/severityOrIgnore"}
      }
    },
    "agent": {
      "type": "object",
      "required": ["guidance"],
      "additionalProperties": false,
      "properties": {"guidance": {"type": "string"}}
    }
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"},
    "linkName": {"type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"},
    "typeRef": {
      "description": "A type in this pack (name) or in a required pack (pack/name).",
      "type": "string",
      "pattern": "^([a-z][a-z0-9]*(-[a-z0-9]+)*/)?[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "linkRef": {
      "description": "A link or inverse link in this pack (name) or in a required pack (pack/name).",
      "type": "string",
      "pattern": "^([a-z][a-z0-9]*(-[a-z0-9]+)*/)?[a-z][a-z0-9]*(_[a-z0-9]+)*$"
    },
    "severity": {"enum": ["error", "warn", "advisory"]},
    "severityOrIgnore": {"enum": ["error", "warn", "advisory", "ignore"]},
    "count": {"type": "integer", "minimum": 0},
    "globs": {"type": "array", "items": {"type": "string"}, "minItems": 1},

    "type": {
      "type": "object",
      "required": ["description", "path", "id"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "path": {"type": "string"},
        "id": {"type": "string"},
        "frontmatter": {"type": "object", "description": "JSON Schema for the frontmatter object."},
        "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}},
        "extra_sections": {"enum": ["allow", "forbid"]},
        "lifecycle": {"$ref": "#/$defs/lifecycle"},
        "anchors": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "field": {"type": "string"},
            "tag": {"type": "string"}
          }
        },
        "items": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/name"},
          "additionalProperties": {
            "type": "object",
            "required": ["heading", "id"],
            "additionalProperties": false,
            "properties": {
              "heading": {"type": "string"},
              "id": {"type": "string"}
            }
          }
        },
        "template": {"type": "string"}
      }
    },

    "section": {
      "type": "object",
      "required": ["heading"],
      "additionalProperties": false,
      "properties": {
        "heading": {"type": "string", "minLength": 1},
        "min_words": {"type": "integer", "minimum": 1},
        "optional": {"type": "boolean"}
      }
    },

    "lifecycle": {
      "type": "object",
      "required": ["field", "initial", "transitions"],
      "additionalProperties": false,
      "properties": {
        "field": {"type": "string"},
        "initial": {"type": "string"},
        "transitions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        },
        "frozen": {"type": "array", "items": {"type": "string"}}
      }
    },

    "link": {
      "type": "object",
      "required": ["description", "from", "to"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "from": {"$ref": "#/$defs/typeRefs"},
        "to": {"$ref": "#/$defs/typeRefs"},
        "min": {"$ref": "#/$defs/count"},
        "max": {"type": "integer", "minimum": 1},
        "to_status": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "inverse": {"$ref": "#/$defs/linkName"},
        "acyclic": {"type": "boolean"}
      }
    },

    "typeRefs": {
      "oneOf": [
        {"$ref": "#/$defs/typeRef"},
        {"type": "array", "items": {"$ref": "#/$defs/typeRef"}, "minItems": 1}
      ]
    },

    "selector": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"$ref": "#/$defs/typeRef"},
        "where": {"$ref": "#/$defs/where"}
      }
    },

    "where": {
      "description": "Field conditions. A scalar must equal the field; a list means any of. `parent` matches the containing document of an item.",
      "type": "object",
      "minProperties": 1
    },

    "rule": {
      "type": "object",
      "required": ["id", "description", "severity", "require", "fix"],
      "additionalProperties": false,
      "oneOf": [
        {"required": ["select"]},
        {"required": ["on_change"]}
      ],
      "properties": {
        "id": {"$ref": "#/$defs/name"},
        "description": {"type": "string", "minLength": 1},
        "severity": {"$ref": "#/$defs/severity"},
        "select": {"$ref": "#/$defs/selector"},
        "on_change": {
          "type": "object",
          "required": ["paths"],
          "additionalProperties": false,
          "properties": {
            "paths": {"$ref": "#/$defs/globs"},
            "change": {
              "type": "array",
              "items": {"enum": ["added", "modified", "deleted"]},
              "minItems": 1
            }
          }
        },
        "require": {"$ref": "#/$defs/requirement"},
        "unless": {
          "type": "object",
          "required": ["trailer"],
          "additionalProperties": false,
          "properties": {"trailer": {"type": "string", "minLength": 1}}
        },
        "fix": {"type": "string", "minLength": 1}
      }
    },

    "requirement": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "fields": {"type": "object", "description": "JSON Schema fragment for the frontmatter."},
        "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}, "minItems": 1},
        "outgoing": {"$ref": "#/$defs/linkRequirement"},
        "incoming": {"$ref": "#/$defs/linkRequirement"},
        "anchors": {
          "type": "object",
          "required": ["min"],
          "additionalProperties": false,
          "properties": {"min": {"$ref": "#/$defs/count"}}
        },
        "tagged": {
          "type": "object",
          "required": ["min"],
          "additionalProperties": false,
          "properties": {
            "min": {"$ref": "#/$defs/count"},
            "in": {"$ref": "#/$defs/globs"}
          }
        },
        "items": {
          "type": "object",
          "required": ["type", "min"],
          "additionalProperties": false,
          "properties": {
            "type": {"$ref": "#/$defs/name"},
            "min": {"$ref": "#/$defs/count"}
          }
        },
        "touched": {
          "type": "object",
          "required": ["type", "min"],
          "additionalProperties": false,
          "properties": {
            "type": {"$ref": "#/$defs/typeRef"},
            "where": {"$ref": "#/$defs/where"},
            "min": {"$ref": "#/$defs/count"},
            "anchored": {"type": "boolean"}
          }
        },
        "all": {"type": "array", "items": {"$ref": "#/$defs/requirement"}, "minItems": 2},
        "any": {"type": "array", "items": {"$ref": "#/$defs/requirement"}, "minItems": 2},
        "exec": {
          "type": "object",
          "required": ["run"],
          "additionalProperties": false,
          "properties": {"run": {"type": "string", "minLength": 1}}
        }
      }
    },

    "linkRequirement": {
      "type": "object",
      "required": ["link"],
      "additionalProperties": false,
      "properties": {
        "link": {"$ref": "#/$defs/linkRef"},
        "min": {"$ref": "#/$defs/count"},
        "max": {"$ref": "#/$defs/count"},
        "where": {"$ref": "#/$defs/where"}
      }
    },

    "view": {
      "type": "object",
      "required": ["id", "title", "output", "layout"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/name"},
        "title": {"type": "string", "minLength": 1},
        "output": {"type": "string"},
        "layout": {"enum": ["table", "tree", "matrix"]},
        "select": {"$ref": "#/$defs/selector"},
        "columns": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "sort": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "follow": {"type": "array", "items": {"$ref": "#/$defs/linkRef"}, "minItems": 1},
        "rows": {"$ref": "#/$defs/selector"},
        "cols": {"$ref": "#/$defs/selector"},
        "via": {"type": "array", "items": {"$ref": "#/$defs/linkRef"}, "minItems": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"layout": {"const": "table"}}},
          "then": {"required": ["select", "columns"]}
        },
        {
          "if": {"properties": {"layout": {"const": "tree"}}},
          "then": {"required": ["select", "follow"]}
        },
        {
          "if": {"properties": {"layout": {"const": "matrix"}}},
          "then": {"required": ["rows", "cols", "via"]}
        }
      ]
    }
  }
}
