{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bondstone/bondstone/proof-of-concept/schema/project.schema.json",
  "title": "bondstone project file (bondstone.yaml)",
  "type": "object",
  "required": ["bondstone", "packs", "docs"],
  "additionalProperties": false,
  "properties": {
    "bondstone": {"const": 1, "description": "Project file format version."},
    "profile": {"$ref": "pack.schema.json#/$defs/name"},
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source"],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "description": "A folder in this repository, or a git location: host/org/repo[//subfolder]@ref."
          }
        }
      }
    },
    "docs": {"$ref": "pack.schema.json#/$defs/globs"},
    "code": {"$ref": "pack.schema.json#/$defs/globs"},
    "overrides": {
      "type": "object",
      "propertyNames": {
        "description": "A namespaced rule id: pack/rule, core/rule or local/rule.",
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {"$ref": "pack.schema.json#/$defs/severityOrIgnore"}
    },
    "rules": {"type": "array", "items": {"$ref": "pack.schema.json#/$defs/rule"}},
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "target", "reason", "expires"],
        "additionalProperties": false,
        "properties": {
          "rule": {"type": "string", "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"},
          "target": {"type": "string", "description": "A document or item id."},
          "reason": {"type": "string", "minLength": 10},
          "expires": {"type": "string", "format": "date"}
        }
      }
    },
    "baseline": {"type": "string"}
  }
}
