{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "bondstone",
          "version": "<version>",
          "informationUri": "https://github.com/bondstone/bondstone",
          "rules": [
            {
              "id": "bondstone/supersede-orphan",
              "shortDescription": {
                "text": "A document has the status `superseded` but nothing supersedes it."
              },
              "fullDescription": {
                "text": "A document has the status `superseded` but nothing supersedes it. Readers cannot find what replaced it."
              },
              "help": {
                "text": "Add the supersede link to its successor, or change its status."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "adr-capability/accepted-decision-is-applied",
              "shortDescription": {
                "text": "An accepted decision constrains at least one capability."
              },
              "fullDescription": {
                "text": "An accepted decision constrains at least one capability."
              },
              "help": {
                "text": "An accepted decision constrains at least one capability."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "adr/alternatives-considered",
              "shortDescription": {
                "text": "Accepted decisions record the alternatives that were considered."
              },
              "fullDescription": {
                "text": "Accepted decisions record the alternatives that were considered."
              },
              "help": {
                "text": "Add a \"## Alternatives considered\" section."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "bondstone/field-unknown",
              "shortDescription": {
                "text": "A frontmatter key is neither a field nor a link of the document's type."
              },
              "fullDescription": {
                "text": "A frontmatter key is neither a field nor a link of the document's type. Unknown keys are usually typos of links, which would otherwise be silently ignored."
              },
              "help": {
                "text": "Use one of the fields or links listed in the hint."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "bondstone/link-broken",
              "shortDescription": {
                "text": "A link points to an id that does not exist."
              },
              "fullDescription": {
                "text": "A link points to an id that does not exist. Broken links are exactly the drift bondstone exists to prevent."
              },
              "help": {
                "text": "Fix the id or create the missing document."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "adr-capability/constrained-by-live-decision",
              "shortDescription": {
                "text": "Capabilities are constrained only by proposed or accepted decisions."
              },
              "fullDescription": {
                "text": "Capabilities are constrained only by proposed or accepted decisions."
              },
              "help": {
                "text": "Point to the decision that superseded it."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "bondstone/code-coverage",
              "shortDescription": {
                "text": "A code-traceable node is not tagged anywhere in code. With `when`, only nodes in the listed statuses are checked."
              },
              "fullDescription": {
                "text": "A code-traceable node is not tagged anywhere in code. With `when`, only nodes in the listed statuses are checked. An untagged requirement may be unimplemented, or its code cannot be found."
              },
              "help": {
                "text": "Add a `bondstone: <id>` comment above the implementing code."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "bondstone/view-stale",
              "shortDescription": {
                "text": "A generated view is missing or differs from what `bondstone gen` would write."
              },
              "fullDescription": {
                "text": "A generated view is missing or differs from what `bondstone gen` would write. Committed views must match the documents they are generated from."
              },
              "help": {
                "text": "Run `bondstone gen` and commit the result."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "bondstone/untyped-document",
              "shortDescription": {
                "text": "A file under the profile's `docs` globs is at no type's path."
              },
              "fullDescription": {
                "text": "A file under the profile's `docs` globs is at no type's path. Managed folders hold only documents that bondstone can check."
              },
              "help": {
                "text": "Move the file to a type's path, or narrow `docs` in the profile."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "bondstone/code-ref-unknown",
              "shortDescription": {
                "text": "A code tag `bondstone: <id>` refers to an id that does not exist."
              },
              "fullDescription": {
                "text": "A code tag `bondstone: <id>` refers to an id that does not exist. A tag for something the documentation does not contain is stale traceability."
              },
              "help": {
                "text": "Fix or remove the tag."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true
        }
      ],
      "results": [
        {
          "ruleId": "bondstone/supersede-orphan",
          "ruleIndex": 0,
          "level": "note",
          "message": {
            "text": "ADR-001 is superseded but nothing supersedes it"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/adr/ADR-001-a.md",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 5
                }
              }
            }
          ],
          "partialFingerprints": {
            "bondstone/v1": "8ea6993524345e8ba711ef23dc917094"
          },
